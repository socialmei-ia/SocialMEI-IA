# Test-only fixture for the retired HTTP Basic gateway. NEVER deploy or mount on the public site.
# Internal gateway. Only the existing HTTPS proxy joins the web network.
:80 {
    @foreign_origin {
        header Origin *
        not header Origin https://{$SOCIALMEI_TEAM_HOST}
    }
    @app_assets path /scripts/* /styles/* /assets/* /config.js
    @technical_reads {
        method GET
        path /api/v1/integracoes/resumo /api/v1/integracoes/clientes /api/v1/integracoes/produtos /api/v1/integracoes/vendas /api/v1/integracoes/financeiro
    }
    # Meta must reach this endpoint without the browser Basic Auth challenge.
    # The API authenticates POST by raw HMAC signature and GET by verify token.
    @instagram_webhook path /webhooks/instagram
    @browser_requests {
        not path /media/instagram/*
        not path /webhooks/instagram
        not {
            method GET
            path /api/v1/integracoes/resumo /api/v1/integracoes/clientes /api/v1/integracoes/produtos /api/v1/integracoes/vendas /api/v1/integracoes/financeiro
        }
    }
    # Literal order: authorization and Origin checks precede every handler.
    route {
        basic_auth @browser_requests {
            import /etc/caddy/private/users.Caddyfile
        }
        respond @foreign_origin "Origem não permitida." 403
        header {
            X-Content-Type-Options nosniff
            Referrer-Policy same-origin
            Cache-Control no-store
        }
        request_body {
            max_size 3MB
        }
        # Signature-verified Meta webhook (no n8n flow is replaced here).
        handle @instagram_webhook {
            reverse_proxy team-api:8000 {
                header_up -Authorization
            }
        }
        # Technical reads authenticate with Bearer inside the API.
        handle @technical_reads {
            reverse_proxy team-api:8000
        }
        # Only unguessable, expiring JPEG capabilities are delivered without a session.
        handle /media/instagram/* {
            @media_read method GET
            route {
                reverse_proxy @media_read team-api:8000 {
                    header_up -Authorization
                    header_up -Cookie
                }
                respond "Não encontrado." 404
            }
        }
        handle /api/v1/* {
            reverse_proxy team-api:8000 {
                header_up -Authorization
            }
        }
        handle /health/db {
            reverse_proxy team-api:8000 {
                header_up -Authorization
            }
        }
        handle_path /frontend/* {
            root * /srv/frontend
            file_server
        }
        handle / {
            root * /srv/frontend
            rewrite * /socialmei-app.html
            file_server
        }
        handle /index.html {
            redir * / 302
        }
        # Relative assets also work when the application is opened at /.
        handle @app_assets {
            root * /srv/frontend
            file_server
        }
        handle {
            respond "Não encontrado." 404
        }
    }
}
