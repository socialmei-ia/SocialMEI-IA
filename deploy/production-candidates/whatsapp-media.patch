+def _everson_media_route(conn, channel, message, state, native):
+    workspace, cid, conv = channel['workspace_id'], channel['channel_id'], message['conversation_id']
+    skip = {'action': 'media_no_reply', 'text': '', 'choices': [], 'items': [],
+            'handoff': state['state'] == 'human'}
+    if state['state'] != 'menu' or pending_human_reply(conn, workspace, cid, conv, message['id']):
+        return state['state'], skip
+
+    requested = media.intent(message['media_kind'], message['interpretation'])
+    if requested == 'booking' and _sm_booking_ready(conn, channel):
+        import channel_booking_flow as flow
+        # A media interpretation can open the service picker. Later selections are explicit.
+        try:
+            with conn.transaction():
+                next_state, result = flow.advance(
+                    conn, channel, message, {'route': 'booking', 'step': 'services'}, native)
+        except HTTPException as error:
+            if error.status_code not in {409, 422, 503}:
+                raise
+        else:
+            return next_state, {**result, 'derived_from_media': True}
+    elif requested in {'products', 'services', 'quote'}:
+        command = {'products': '2', 'services': '3', 'quote': '4'}[requested]
+        next_state, result = _catalog_answer(conn, workspace, state['state'], command, None, native)
+        return next_state, {**result, 'derived_from_media': True}
+
+    if requested is None:
+        return state['state'], skip
+    text = (
+        'Recebi seu anexo. Para ajudar, diga por texto se quer consultar o catálogo, pedir um orçamento ou agendar.'
+        if requested == 'context_only'
+        else 'Para continuar, escolha no menu o que deseja consultar ou escreva seu pedido.'
+    )
+    _, menu = _catalog_answer(conn, workspace, 'menu', '0', None, native)
+    menu = _sm_booking_menu(conn, channel, message, state, menu)
+    return state['state'], {**menu, 'action': 'media_clarify', 'text': text, 'derived_from_media': True}
+
