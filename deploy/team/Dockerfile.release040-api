# Root build context includes the optional Instagram worker in the immutable image.
FROM python:3.12-slim
ARG SOCIALMEI_RELEASE_SHA=unknown
ENV SOCIALMEI_RELEASE_SHA=$SOCIALMEI_RELEASE_SHA
LABEL org.opencontainers.image.revision=$SOCIALMEI_RELEASE_SHA
LABEL org.socialmei.release.profile="040"
WORKDIR /app
COPY python-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY python-service/*.py ./
COPY tools/instagram-auto-menu-worker.py ./instagram-auto-menu-worker.py
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
