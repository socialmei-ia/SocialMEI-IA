# Proposal only. Install after explicit approval, private target review and verified isolated restore.
[Unit]
Description=SocialMEI approved PostgreSQL040 backup with private retention report
After=docker.service
Requires=docker.service
OnFailure=socialmei-postgres040-backup-alert.service

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/socialmei/backup040.private.env
ExecStart=/usr/bin/flock -n /run/lock/socialmei-backup040.lock /usr/bin/python3 ${SOCIALMEI_BACKUP_SCRIPT} --run --with-manifest --config-root /var/lib/socialmei/postgres040-backups backup
ExecStartPost=/usr/bin/python3 ${SOCIALMEI_BACKUP_RETENTION_SCRIPT} --directory /var/lib/socialmei/postgres040-backups/backups --report /var/lib/socialmei/postgres040-backups/backups/retention-report.private.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/socialmei/postgres040-backups /run/lock
MemoryMax=96M
TimeoutStartSec=300
