# PostgreSQL
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha_segura
POSTGRES_DB=n8n

# n8n
N8N_ENCRYPTION_KEY=gere_uma_chave_secreta_aqui

N8N_HOST=seu-host.exemplo.com
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://seu-host.exemplo.com
N8N_WEBHOOK_URL=https://seu-host.exemplo.com
N8N_PROXY_HOPS=1

# pgAdmin (painel web do banco)
# Use credenciais reais somente no arquivo .env do servidor. Nunca faça commit delas.
PGADMIN_HOST=db.seu-host.exemplo.com
PGADMIN_DEFAULT_EMAIL=admin@exemplo.com
PGADMIN_DEFAULT_PASSWORD=troque_por_uma_senha_forte

# WAHA / WhatsApp
# Gere valores fortes no servidor e mantenha-os apenas no .env real.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque_por_uma_senha_forte
WAHA_API_KEY=gere_uma_chave_api_forte

# Fuso horário
TZ=America/Recife
GENERIC_TIMEZONE=America/Recife
