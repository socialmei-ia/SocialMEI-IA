{
  "name": "socialmei-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Ferramentas de manutenção do frontend estático SocialMEI.IA",
  "scripts": {
    "preview": "node tools/preview.mjs",
    "test:preview": "node tests/v22-preview-browser.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/v22-browser.cjs",
    "format": "prettier --write frontend tools tests *.html *.json .github docs *.md compose*.yaml",
    "format:check": "prettier --check frontend tools tests *.html *.json .github docs *.md compose*.yaml",
    "setup": "node tools/dev-workspace.mjs setup",
    "dev": "node tools/dev-workspace.mjs up",
    "dev:tools": "node tools/dev-workspace.mjs up-tools",
    "dev:waha": "node tools/dev-workspace.mjs up-waha",
    "stop": "node tools/dev-workspace.mjs down",
    "status": "node tools/dev-workspace.mjs status",
    "logs": "node tools/dev-workspace.mjs logs",
    "dev:config": "node tools/dev-workspace.mjs config",
    "db:migrate": "node tools/db-migrate.mjs migrate",
    "db:status": "node tools/db-migrate.mjs status",
    "doctor": "node tools/team-doctor.mjs",
    "data:export": "node tools/export-workspace.mjs",
    "demo:build": "node tools/package-public-demo.mjs",
    "demo:verify": "node tools/verify-public-demo.mjs",
    "demo:smoke": "node tests/public-demo-published-browser.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
}
