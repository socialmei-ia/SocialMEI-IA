{
  "name": "socialmei-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Ferramentas de manuten\u00e7\u00e3o do frontend est\u00e1tico SocialMEI.IA",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "format": "prettier --write frontend prototypes tools tests *.html *.json .github docs *.md compose*.yaml",
    "format:check": "prettier --check frontend prototypes tools tests *.html *.json .github docs *.md compose*.yaml",
    "setup": "node tools/dev-workspace.mjs setup",
    "dev": "node tools/dev-workspace.mjs up",
    "dev:tools": "node tools/dev-workspace.mjs up-tools",
    "dev:waha": "node tools/dev-workspace.mjs up-waha",
    "stop": "node tools/dev-workspace.mjs down",
    "status": "node tools/dev-workspace.mjs status",
    "logs": "node tools/dev-workspace.mjs logs",
    "dev:config": "node tools/dev-workspace.mjs config",
    "db:migrate": "node tools/db-migrate.mjs migrate",
    "db:status": "node tools/db-migrate.mjs status",
    "doctor": "node tools/team-doctor.mjs",
    "data:export": "node tools/export-workspace.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
}
